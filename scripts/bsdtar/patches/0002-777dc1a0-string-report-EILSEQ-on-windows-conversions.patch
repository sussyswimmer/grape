From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tobias Stoeckmann <tobias@stoeckmann.org>
Date: Sat, 17 Oct 2026 12:31:13 +0200
Subject: [PATCH] string: Report EILSEQ on Windows conversions

If an illegal sequence is encountered, properly report it through EILSEQ
so alternative conversions can be tested within archive_entry_pathname.

Reduce visibility of defchar_used and make sure that any use of default
characters is properly reported (due to the loop which resets the value).

Resolves #3681
Resolves #3695

Co-authored-by: Volodymyr Rybkin <slon-aby@users.noreply.github.com>
Signed-off-by: Tobias Stoeckmann <tobias@stoeckmann.org>

[Grape: upstream 777dc1a0 (PR #3696, merged 8c4d7d77 2026-10-18).
Changed from upstream: only the libarchive/archive_string.c hunk is
kept. The hunks in libarchive/test/test_{gnutar,ustar,v7tar,zip}_
filename_encoding.c are dropped, because Grape builds with
ENABLE_TEST=OFF and never compiles them.]
---
 libarchive/archive_string.c | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/libarchive/archive_string.c b/libarchive/archive_string.c
index 474dff8..1d07859 100644
--- a/libarchive/archive_string.c
+++ b/libarchive/archive_string.c
@@ -710,7 +710,6 @@ static int
 archive_string_append_from_wcs_in_codepage(struct archive_string *as,
     const wchar_t *ws, size_t len, struct archive_string_conv *sc)
 {
-	BOOL defchar_used, *dp;
 	int ret = 0;
 	UINT to_cp;
 	size_t count, wslen = len;
@@ -732,12 +731,12 @@ archive_string_append_from_wcs_in_codepage(struct archive_string *as,
 			return (-1);
 		p = as->s + as->length;
 		count = 0;
-		defchar_used = 0;
 		while (count < wslen && *wp) {
 			if (*wp > 255) {
 				*p++ = '?';
 				wp++;
-				defchar_used = 1;
+				errno = EILSEQ;
+				ret = -1;
 			} else
 				*p++ = (char)*wp++;
 			count++;
@@ -750,7 +749,6 @@ archive_string_append_from_wcs_in_codepage(struct archive_string *as,
 			return (-1);
 		u16 = (uint16_t *)(as->s + as->length);
 		count = 0;
-		defchar_used = 0;
 		if (sc->flag & SCONV_TO_UTF16BE) {
 			while (count < len && *ws) {
 				archive_be16enc(u16+count, *ws);
@@ -772,6 +770,7 @@ archive_string_append_from_wcs_in_codepage(struct archive_string *as,
 			return (-1);
 		do {
 			int r;
+			BOOL defchar_used, *dp;
 
 			defchar_used = 0;
 			if (to_cp == CP_UTF8)
@@ -797,15 +796,17 @@ archive_string_append_from_wcs_in_codepage(struct archive_string *as,
 					return (-1);
 				continue;
 			}
-			if (r == 0)
+			if (r == 0 || defchar_used) {
+				errno = EILSEQ;
 				ret = -1;
+			}
 			count = (size_t)r;
 			break;
 		} while (1);
 	}
 	as->length += count;
 	as->s[as->length] = '\0';
-	return (defchar_used?-1:ret);
+	return (ret);
 }
 
 #elif defined(HAVE_WCTOMB) || defined(HAVE_WCRTOMB)
